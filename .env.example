# Copy to .env for local Docker Compose. Do not commit real secrets.

# ── Gateway ──────────────────────────────────────────────────────
KATER_PROFILE=core

# Local dev (loopback, no auth):
# KATER_HOST=127.0.0.1

# Public / tunnel exposure — REQUIRED before going live:
# KATER_PUBLIC=1
# KATER_AUTH_MODE=oauth          # ChatGPT Remote MCP (recommended)
# KATER_AUTH_MODE=apikey         # Cursor / agents with Bearer token
# KATER_API_KEY=                 # required when auth=apikey
# KATER_RATE_LIMIT=60
# KATER_CORS_ORIGINS=https://your-domain.example

# ── Ports (optional, defaults: API=9091, MCP=9090, WS=9092) ─────
# KATER_API_PORT=9091
# KATER_MCP_PORT=9090
# KATER_WS_PORT=9092

# ── OAuth (when KATER_AUTH_MODE=oauth) ───────────────────────────
# KATER_OAUTH_ISSUER=
# KATER_OAUTH_AUDIENCE=
# KATER_OAUTH_JWKS_URL=

# ── Context tokens (optional) ─────────────────────────────────────
# HMAC secret for signed remote-context tokens (X-Kater-Context / Bearer).
# When unset, falls back to the first API key or a process-local secret.
# Multi-instance / production: set a stable shared secret (do not rely on
# the process-local fallback, which differs per process and breaks verify).
# KATER_CONTEXT_TOKEN_SECRET=

# ── Hardening (optional, recommended for public deploys) ──────────
# Separate "use tools" from "change settings". When set, sensitive settings
# mutations (auth mode, api_keys, CORS, rate limit) require this admin key.
# KATER_ADMIN_KEY=
# Catalog Connect (outbound OAuth). Public/company-control persist is deny-default.
# Local 0600 .kater/settings.json is development-only and requires this opt-in:
# KATER_CONNECT_ALLOW_LOCAL_SETTINGS=0
# Named sink: local-settings (local opt-in only) or chefvault (reference only —
# this gateway does not write Vault items; see docs/ops/chefvault.md).
# KATER_CONNECT_SECRET_SINK=
# Canonical HTTPS origin for public Connect redirects. Never derived from Host.
# KATER_CONNECT_PUBLIC_BASE_URL=https://kater.example.com
# Lock down OAuth dynamic client registration (/register). When set, callers
# must pass X-Registration-Token (or ?registration_token=) to register a client.
# KATER_REGISTRATION_TOKEN=
# Dashboard shortcut key — bypasses OAuth token validation in oauth mode for a
# browser-side dashboard session. Optional; unset = disabled.
# KATER_DASHBOARD_KEY=

# ── Proxy (optional) ─────────────────────────────────────────────
# Enable the MCP proxy engine (tool aggregation across multiple servers).
# KATER_PROXY=1
# Enable live MCP proxy backends in `kater serve` (requires adapter API keys).
# Comma-separated public-facing hostnames for HTTPS detection behind tunnels.
# Also allowlisted for MCP SSE DNS-rebinding protection (Host/Origin headers).
# KATER_HTTPS_HOSTS=your-domain.example
# Self-referencing MCP SSE URL (used by external adapter to discover itself).
# KATER_URL=http://127.0.0.1:9090

# ── Tunnel (optional) ────────────────────────────────────────────
# Public hostname for Cloudflare Tunnel. Required so /sse accepts Host: <domain>
# instead of returning 421 (Cloudflare then shows 502).
# KATER_DOMAIN=your-domain.example
# KATER_TUNNEL_UNIT=kater-tunnel  # systemd unit name override

# ── Optional MCP adapter keys ────────────────────────────────────
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITLAB_PERSONAL_ACCESS_TOKEN=
# LINEAR_API_KEY=
# Linear MCP bearer token for https://mcp.linear.app/mcp (Settings → Security & Access).
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# HF_TOKEN=
# BRAVE_API_KEY=
# SANITY_API_TOKEN=
# SENTRY_AUTH_TOKEN=
# NOTION_API_KEY=
# UPSTASH_EMAIL=
# UPSTASH_API_KEY=
# RESEND_API_KEY=
# SLACK_ACCESS_TOKEN=
# SLACK_MCP_CLIENT_ID=
# SLACK_MCP_CLIENT_SECRET=
# DATABASE_URL=

# ── Optional custom extensions (private deployments) ─────────────
# KATER_EXTENSIONS_MODULE=your_package.extensions
# Extension modules may export TOOL_SOURCES, PRIVATE_PROFILES, NATIVE_TOOLS,
# CHAINS, and CAPABILITIES (capability manifests for domain overlays).
# See docs/profiles.md and docs/architecture/
# Private deployments may document additional overlay wiring in
# docs/ops/private-overlays.md.

# Native browser lane (optional; pip/uv install kater[browser] && playwright install chromium)
# Three backends — pick one with KATER_BROWSER_PROVIDER (see docs/browser.md):
#   local  — Playwright Chromium in-process (default)
#   cdp    — attach to Browserless / chrome --remote-debugging-port / any CDP URL
#   steel  — Steel Browser OSS (https://github.com/steel-dev/steel-browser); alias: remote
# On public deployments (KATER_PUBLIC=1) browser tools are NOT auto-exposed even
# when a provider is configured; opt in explicitly with a truthy value (1/true/yes/on):
# KATER_BROWSER_ENABLE=0
# KATER_BROWSER_PROVIDER=local   # local | cdp | steel | remote
# KATER_BROWSER_CDP_URL=http://127.0.0.1:9222
# KATER_BROWSER_STEEL_URL=
# KATER_BROWSER_STEEL_KEY=
# KATER_BROWSER_ALLOW_DOMAINS=example.com,*.example.org
# KATER_BROWSER_DENY_DOMAINS=
# KATER_BROWSER_ALLOW_PRIVATE=0
# KATER_BROWSER_MAX_SESSIONS=4
# KATER_BROWSER_SESSION_TTL=1800
# KATER_BROWSER_ACTION_TIMEOUT_MS=15000
# KATER_BROWSER_NO_SANDBOX=0
# KATER_BROWSER_ALLOW_EVALUATE=0
# KATER_BROWSER_MAX_PAGES_PER_SESSION=5
# KATER_BROWSER_MAX_SCREENSHOT_BYTES=2097152

# ── Computer guest connector (optional) ───────────────────────────
# When URL + TOKEN are set, runtime registers the Computer connector for
# MCP proxy, REST (/api/computer*), and `kater computer` CLI.
# KATER_COMPUTER_URL=http://127.0.0.1:8080
# KATER_COMPUTER_TOKEN=
# KATER_COMPUTER_PROFILE=core
