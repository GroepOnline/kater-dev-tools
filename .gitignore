.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
# Coverage artifacts (produced by pytest-cov on every run).
.coverage
.coverage.*
coverage.xml
htmlcov/
.env
.env.local
.env.kater.example
*.pyc
# Cursor runtime outputs (committed SSOT lives under .cursor/skills, agents, hooks)
.cursor/hooks/.state/
.cursor/mcp.json
.cursor/mcp.kater.json
.cursor/.env.runtime
.claude/
.opencode/

# Runtime state — never commit (db + sqlite sidecars + oauth)
.kater/

# Advisory lock sidecars for the agent-taste signals registry
.agents/registry/*.lock
