.agents/registry/*.lock

# Compound Engineering checkout-local settings (tracked: config.yaml + example)
.compound-engineering/*.local.yaml

# ChefGroep standard ignores (OS / Xcode / local env / CE)
.compound-engineering/*.local.yaml

