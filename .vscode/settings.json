{
  "files.associations": {
    "SKILL.md": "markdown",
    "*.mdc": "markdown"
  },
  "files.exclude": {
    "**/.cursor/hooks/.state": true
  },
  "search.exclude": {
    "**/.cursor/hooks/.state": true
  },
  "files.watcherExclude": {
    "**/.cursor/hooks/.state/**": true
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
