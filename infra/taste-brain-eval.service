# taste-brain-eval.service — fleet only (chef-control-01 / kater host)
# Do NOT install on laptop joep (zero-local).

[Unit]
Description=ChefGroep agent-taste + design-system brain eval
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=KATER_DIR=/var/lib/kater-dev-tools
Environment=DESIGN_SYSTEM_DIR=/var/lib/design-system
# systemd does not read .bashrc/.profile, so uv (installed in ~/.local/bin) needs
# to be on PATH explicitly.
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Report-only by default. Set COMMIT=1 via drop-in to push chore/eval-scorecards.
ExecStart=/usr/bin/env bash /var/lib/kater-dev-tools/scripts/run-taste-brain-eval.sh
Nice=10
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
