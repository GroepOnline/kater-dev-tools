# taste-brain-eval.timer — nightly fleet eval (offset from GHA cron 04:27 UTC)

[Unit]
Description=Nightly agent-taste + design-system brain eval
# No Requires= on the service: that would activate it when the timer starts,
# outside the OnCalendar schedule. Unit= below is enough.

[Timer]
OnCalendar=*-*-* 04:40:00 UTC
Persistent=true
RandomizedDelaySec=120
Unit=taste-brain-eval.service

[Install]
WantedBy=timers.target
