{
  "schema_version": 1,
  "description": "Kater release contract. Dictates which tag shapes each channel allows, how artifacts are named, and the prerelease flag rules. Enforced by scripts/validate_release.py and .github/workflows/release.yml.",
  "channels": {
    "stable": {
      "name": "stable",
      "description": "Production-ready releases. Only exact semver tags on main.",
      "tag_pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "version_pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "prerelease": false,
      "allowed_refs": ["main"],
      "artifact_naming": "kater-{version}-py3-none-any.whl (wheel) and kater-{version}.tar.gz (sdist)"
    },
    "development": {
      "name": "development",
      "description": "Pre-release development snapshots. X.Y.Z.devN on main, always marked prerelease.",
      "tag_pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(dev)[0-9]+$",
      "version_pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(dev)[0-9]+$",
      "prerelease": true,
      "allowed_refs": ["main"],
      "artifact_naming": "kater-{version}-py3-none-any.whl (wheel) and kater-{version}.tar.gz (sdist)"
    }
  },
  "policies": {
    "immutable_ancestry": true,
    "tag_must_point_at_commit_on_main": true,
    "version_must_match_package": true,
    "artifact_version_must_equal_tag_version": true
  },
  "version_sources": [
    "pyproject.toml (project.version)",
    "src/kater/__init__.py (__version__)"
  ]
}